{
  "name": "@microrealestate/pdfgenerator",
  "version": "1.0.0",
  "description": "Generates PDF documents (letters, contracts, invoices...)",
  "main": "./src/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean:types": "rimraf ../../types/dist",
    "clean:common": "rimraf ../common/dist",
    "clean": "npm-run-all clean:types clean:common",
    "transpile:types": "tsc --build ../../types/tsconfig.json",
    "transpile:common": "tsc --build ../common/tsconfig.json",
    "transpile": "npm-run-all transpile:types transpile:common",
    "build": "npm-run-all clean transpile",
    "watch:types": "tsc --build ../../types/tsconfig.json --watch --preserveWatchOutput",
    "watch:common": "tsc --build ../common/tsconfig.json --watch --preserveWatchOutput",
    "watch:service": "nodemon -w src --inspect=0.0.0.0:9227 --no-colours ./src/index.js",
    "start": "node ./src/index.js",
    "dev": "npm-run-all build --parallel watch:types watch:common watch:service",
    "eslint": "eslint .",
    "lint": "npm-run-all transpile eslint",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,css}'"
  },
  "keywords": [
    "microrealestate",
    "realestate",
    "document",
    "pdf"
  ],
  "author": "Camel Aissani",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@microrealestate/common": "*",
    "async-mutex": "0.5.0",
    "ejs": "3.1.10",
    "file-url": "3.0.0",
    "fs-extra": "10.1.0",
    "handlebars": "4.7.7",
    "i18n": "0.14.2",
    "jsonwebtoken": "9.0.0",
    "locale": "0.1.0",
    "moment": "2.29.4",
    "multer": "1.4.5-lts.1",
    "puppeteer": "23.2.1",
    "sanitize-filename": "1.6.3",
    "swagger-jsdoc": "6.2.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "fast-check": "^3.22.0",
    "mongodb-memory-server": "10.3.0",
    "nodemon": "3.1.4",
    "npm-run-all": "4.1.5",
    "rimraf": "6.0.1",
    "supertest": "6.1.3",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  }
}
